# =============================================================================
# ASUNHOME ERP — variables de entorno
# Copiar a .env.local (dev) o cargar en Coolify (producción).
# =============================================================================

# --- Schema Postgres de esta instancia --------------------------------------
# Debe coincidir con el schema creado por el script SQL y estar en
# "Exposed schemas" de Supabase (Settings → API).
NEURA_CLIENT_SCHEMA=asunhome

# --- Supabase (self-hosted) --------------------------------------------------
# NEXT_PUBLIC_* se inlinean en build: en Coolify van también como build args.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.tu-dominio.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa Postgres (pool pg: RPC, migraciones, jobs)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
SUPABASE_DB_PASSWORD=
PG_POOL_MAX=10

# --- Acceso / roles ----------------------------------------------------------
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=admin@asunhome.com.py

# --- Facturación electrónica (SIFEN) ----------------------------------------
# Clave para cifrar el password del certificado en DB. Obligatoria si se usa SIFEN.
SIFEN_SECRETS_KEY=
FACTURA_PREFIJO=001-001
FACTURA_DIAS_CREDITO_DEFAULT=30

# --- WhatsApp / Omnicanal (opcional) ----------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
NEXT_PUBLIC_WHATSAPP_LINK_PHONE_NUMBER=

# --- OCR de comprobantes (opcional) -----------------------------------------
GOOGLE_CLOUD_VISION_API_KEY=

# --- Webhooks (opcional) -----------------------------------------------------
WEBHOOK_SECRET=
WEBHOOK_URL=
